# Clé API Google Gemini pour l'assistant client autonome (src/app/api/chat)
# Gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL publique du site en production (utilisée pour le SEO : sitemap, Open
# Graph, données structurées, canonical). À renseigner avec le vrai domaine
# une fois déployé, ex. https://arc-wear.com
NEXT_PUBLIC_SITE_URL=

# Clé Web3Forms pour l'envoi réel des messages du formulaire de contact
# (src/components/ContactForm.tsx). Gratuite, sans carte bancaire :
# https://web3forms.com — entrer l'email qui doit recevoir les messages,
# la clé arrive par email. Publique par design (utilisée côté navigateur),
# ce n'est pas un secret à protéger comme les autres clés de ce fichier.
NEXT_PUBLIC_WEB3FORMS_KEY=
