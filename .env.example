# Clé API Anthropic pour l'assistant client autonome (src/app/api/chat)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# URL publique du site en production (utilisée pour le SEO : sitemap, Open
# Graph, données structurées, canonical). À renseigner avec le vrai domaine
# une fois déployé, ex. https://arc-wear.com
NEXT_PUBLIC_SITE_URL=
