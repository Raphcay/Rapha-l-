# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.

# Clé API ElevenLabs (https://elevenlabs.io -> icône profil -> API Keys)
ELEVENLABS_API_KEY=

# Voice ID ElevenLabs. Sur le plan gratuit, seules les voix natives
# ("My Voices" créées par toi ou les voix par défaut du compte) fonctionnent —
# les voix piochées dans la Voice Library renvoient une erreur 402.
# Par défaut : Adam (voix grave, masculine), choisie après essais.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optionnel : pour forcer un micro précis si le micro par défaut ne capte pas.
# Liste tes micros avec:
#   .venv/bin/python -c "import sounddevice as sd; print(sd.query_devices())"
# puis mets ici l'index (ex: 2) ou un bout du nom (ex: "MacBook").
# JARVIS_INPUT_DEVICE=
